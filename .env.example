# Copy to .env and fill in. Keep it private: chmod 600 .env

# KB증권 Open API (experimental: never run against a live account yet): one app key pair = one account
KB_APP_KEY=
KB_APP_SECRET=
KB_ACCOUNT_NO=
KB_ACCOUNT_NAME=KB증권

# 한국투자증권 KIS Developers
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_CANO=
KIS_ACNT_PRDT_CD=01
KIS_ACCOUNT_NAME=한국투자증권
# 1 = also try the unpublished 계좌입출금고거래내역 API
KIS_TRY_DEPOSIT_API=0

# 토스증권 Open API: issued in the Toss WTS under 설정 > Open API (register this PC's IP there)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# DC pension without an API that buys one KRX ETF with each monthly contribution (assetlog/dcmodel.py).
# DC_START: a date the holdings are known exactly, the shares then, and the cash then (incl. a contribution not yet invested)
DC_ACCOUNT=
DC_SYMBOL=438100
DC_START=
# Your plan's rules: the contribution day of the month (or the business day before it) and how many KRX trading days
# later the bank buys. Leave empty for 25 and 5.
DC_DAY=
DC_BUY_LAG=

# Accounts with no API, kept by hand from the app's 입력 tab (create them there first, institution "manual").
# Savings counted at principal only (예금·적금): comma-separated account ids; a higher balance you enter is booked as a deposit.
ASSETLOG_PRINCIPAL_ONLY=
# A gold spot account (e.g. KB증권 금현물): grams x the KRX gold close from KIS. Needs the KIS keys above.
ASSETLOG_GOLD_ACCOUNT=

# Phone access through the Cloudflare Worker in cloud/ (python3 -m assetlog cloud, every 15 min). Values only.
# CLOUD_URL: the workers.dev URL. CLOUD_PC_KEY: the same value given to `wrangler secret put PC_KEY`.
# CF_ACCESS_*: the Access service token "assetlog-pc" the PC passes Access with; leave empty against a local
# `wrangler dev`. The dashboard shows it as "CF-Access-Client-Id: <value>": paste only the <value> part.
CLOUD_URL=
CLOUD_PC_KEY=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
